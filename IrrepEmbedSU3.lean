import CentreCharacterSU3

/-!
# The SU(3) representation `V(p, q)` inside `3^{⊗p} ⊗ 3̄^{⊗q}`

Author: Jeromie Beasley (Spectrum · Colour team lead, Grok Bot), with the Team.
ORCID https://orcid.org/0009-0006-4645-5643 · GitHub dicipler-pixel · X @d1c1pler ·
YouTube @AtlasMemoriae · atlas-memoriae.dicipler.workers.dev

`CentreCharacterSU3` proves that `ω·I` acts by `ω ^ triality (p, q)` on `3^{⊗p} ⊗ 3̄^{⊗q}`
and on anything with a mono into it, but Mathlib v4.33.0 has no object "the SU(3) irrep with
highest weight `(p, q)`". This file supplies a concrete stand-in and the embedding.

**Defined.**
* `hwVec p q := e₁^{⊗p} ⊗ e₃*^{⊗q} ∈ 3^{⊗p} ⊗ 3̄^{⊗q}`, the classical highest-weight vector.
* `irrepSub p q`: the ℂ-span of the SU(3)-orbit of `hwVec p q`, i.e. the cyclic
  subrepresentation it generates. `irrepRep p q` is that subspace as an object of
  `FDRep ℂ SU3`, written `V(p, q)` below, and `irrepIncl p q : V(p, q) ⟶ 3^{⊗p} ⊗ 3̄^{⊗q}`.

**Proved.**
* `irrepSub_invariant`, `mono_irrepIncl`: `V(p, q)` is a subrepresentation with a mono into the
  tensor power. `hwVec_ne_zero`, `irrepSub_ne_bot`: it is nonzero. `irrepSub_le`: it is the
  smallest invariant subspace containing `hwVec p q`.
* `hwVec_torus_weight`: `diag(d₀, d₁, d₂) ∈ SU(3)` acts on `hwVec p q` by
  `d₀ ^ p * conj(d₂) ^ q`, so `hwVec p q` is a torus weight vector of weight `(p, q)`.
* `centreCharacter_irrep`: `V(p, q)` has centre character `ω ^ ((p + 2q) mod 3)`.
* `triality_eq_of_mono`: if `V(p, q)` embeds in `3^{⊗p'} ⊗ 3̄^{⊗q'}` then the trialities agree;
  `irrep11_not_mono_tensor20`, `irrep11_not_centre_omega_sq`: the adjoint `V(1, 1)` does not
  embed in `3 ⊗ 3` and does not carry its centre character `ω²`.
* `nvalent_triality_irrep`: n-valent triality conservation for arms isomorphic to `V(p, q)`,
  with no named hypothesis.

**Not proved (open).**
* Irreducibility of `V(p, q)`. Classically the cyclic module generated by a highest-weight
  vector is the irrep of highest weight `(p, q)` (it is the traceless symmetric part of the
  tensor power), but that needs the raising operators / Lie algebra and Weyl's theorem, which
  are not formalized here. Only the torus-weight property of the generator is proved, not that
  the raising operators kill it.
* That every irreducible SU(3) representation is isomorphic to some `V(p, q)` (highest-weight
  classification). So `nvalent_triality_irrep` covers arms given as `V(p, q)` up to iso.
* The `(p, q)` here is the `Irrep := ℕ × ℕ` label of `ThetaFloor`/`ThetaTriality`, and the
  triality is the same `triality`. That the representation `V(p, q)` matches the irrep whose
  Casimir `cas3` and singlet table `hasSinglet` are used in `ThetaFloor` is the classical
  identification and is not proved here.

No continuum or mass-gap statement is made.
-/

open CategoryTheory MonoidalCategory ThetaFloor ThetaTriality TrialityVertex GaugeSupport

namespace IrrepEmbedSU3

open CentreCharacterSU3

/-- `e₁ ∈ 3`. -/
noncomputable def e1 : fund := (Pi.single 0 1 : Fin 3 → ℂ)

/-- `e₃ ∈ ℂ³`. -/
noncomputable def e3vec : Fin 3 → ℂ := Pi.single 2 1

/-- `e₃* ∈ 3̄`, the coordinate functional `x ↦ x₃`. -/
noncomputable def e3dual : antifund := (LinearMap.proj 2 : (Fin 3 → ℂ) →ₗ[ℂ] ℂ)

/-- The coordinate `x ↦ x₁` on `3`. -/
noncomputable def projFund : fund →ₗ[ℂ] ℂ := (LinearMap.proj 0 : (Fin 3 → ℂ) →ₗ[ℂ] ℂ)

/-- Evaluation at `e₃` on `3̄`. -/
noncomputable def evalAnti : antifund →ₗ[ℂ] ℂ := Module.Dual.eval ℂ (Fin 3 → ℂ) e3vec

/-- `e₃*^{⊗q} ∈ 3̄^{⊗q}`. -/
noncomputable def hwAnti : (q : ℕ) → tensorRep 0 q
  | 0 => (1 : ℂ)
  | q + 1 => (e3dual ⊗ₜ[ℂ] hwAnti q : TensorProduct ℂ antifund (tensorRep 0 q))

/-- The highest-weight vector `e₁^{⊗p} ⊗ e₃*^{⊗q} ∈ 3^{⊗p} ⊗ 3̄^{⊗q}`. -/
noncomputable def hwVec : (p q : ℕ) → tensorRep p q
  | 0, q => hwAnti q
  | p + 1, q => (e1 ⊗ₜ[ℂ] hwVec p q : TensorProduct ℂ fund (tensorRep p q))

/-- The coordinate functional on `3̄^{⊗q}` dual to `e₃*^{⊗q}`. -/
noncomputable def coefAnti : (q : ℕ) → (tensorRep 0 q →ₗ[ℂ] ℂ)
  | 0 => (LinearMap.id : ℂ →ₗ[ℂ] ℂ)
  | q + 1 => ((TensorProduct.lid ℂ ℂ).toLinearMap ∘ₗ
      TensorProduct.map evalAnti (coefAnti q) :
      TensorProduct ℂ antifund (tensorRep 0 q) →ₗ[ℂ] ℂ)

/-- The coordinate functional on `3^{⊗p} ⊗ 3̄^{⊗q}` dual to `e₁^{⊗p} ⊗ e₃*^{⊗q}`. -/
noncomputable def coef : (p q : ℕ) → (tensorRep p q →ₗ[ℂ] ℂ)
  | 0, q => coefAnti q
  | p + 1, q => ((TensorProduct.lid ℂ ℂ).toLinearMap ∘ₗ
      TensorProduct.map projFund (coef p q) :
      TensorProduct ℂ fund (tensorRep p q) →ₗ[ℂ] ℂ)

theorem projFund_e1 : projFund e1 = 1 := by
  change (Pi.single 0 1 : Fin 3 → ℂ) 0 = 1
  simp

theorem evalAnti_e3dual : evalAnti e3dual = 1 := by
  change (Pi.single 2 1 : Fin 3 → ℂ) 2 = 1
  simp

theorem coefAnti_hwAnti (q : ℕ) : coefAnti q (hwAnti q) = 1 := by
  induction q with
  | zero => rfl
  | succ q ih =>
    change (TensorProduct.lid ℂ ℂ) (TensorProduct.map _ _ (e3dual ⊗ₜ[ℂ] hwAnti q)) = 1
    rw [TensorProduct.map_tmul, TensorProduct.lid_tmul, ih, evalAnti_e3dual, one_smul]

theorem coef_hwVec (p q : ℕ) : coef p q (hwVec p q) = 1 := by
  induction p with
  | zero => exact coefAnti_hwAnti q
  | succ p ih =>
    change (TensorProduct.lid ℂ ℂ) (TensorProduct.map _ _ (e1 ⊗ₜ[ℂ] hwVec p q)) = 1
    rw [TensorProduct.map_tmul, TensorProduct.lid_tmul, ih, projFund_e1, one_smul]

theorem hwVec_ne_zero (p q : ℕ) : hwVec p q ≠ 0 := by
  intro h
  have := coef_hwVec p q
  rw [h, map_zero] at this
  exact zero_ne_one this


/-! ### Weight of the highest-weight vector -/

/-- If `g` scales `e₁` by `a` and `e₃*` by `b`, it scales `e₃*^{⊗q}` by `b ^ q`. -/
theorem rho_hwAnti {g : SU3} {b : ℂ} (hb : antifund.ρ g e3dual = b • e3dual) (q : ℕ) :
    (tensorRep 0 q).ρ g (hwAnti q) = (b ^ q) • hwAnti q := by
  induction q with
  | zero =>
    rw [pow_zero, one_smul]
    rfl
  | succ q ih =>
    change TensorProduct.map (antifund.ρ g) ((tensorRep 0 q).ρ g) (e3dual ⊗ₜ[ℂ] hwAnti q) =
      (b ^ (q + 1)) • (e3dual ⊗ₜ[ℂ] hwAnti q : TensorProduct ℂ antifund (tensorRep 0 q))
    rw [TensorProduct.map_tmul, hb, ih, TensorProduct.smul_tmul_smul, pow_succ, mul_comm]

/-- If `g` scales `e₁` by `a` and `e₃*` by `b`, it scales `e₁^{⊗p} ⊗ e₃*^{⊗q}` by
`a ^ p * b ^ q`. -/
theorem rho_hwVec {g : SU3} {a b : ℂ} (ha : fund.ρ g e1 = a • e1)
    (hb : antifund.ρ g e3dual = b • e3dual) (p q : ℕ) :
    (tensorRep p q).ρ g (hwVec p q) = (a ^ p * b ^ q) • hwVec p q := by
  induction p with
  | zero =>
    rw [pow_zero, one_mul]
    exact rho_hwAnti hb q
  | succ p ih =>
    change TensorProduct.map (fund.ρ g) ((tensorRep p q).ρ g) (e1 ⊗ₜ[ℂ] hwVec p q) =
      (a ^ (p + 1) * b ^ q) • (e1 ⊗ₜ[ℂ] hwVec p q : TensorProduct ℂ fund (tensorRep p q))
    rw [TensorProduct.map_tmul, ha, ih, TensorProduct.smul_tmul_smul, pow_succ]
    congr 1
    ring

/-- A diagonal element `diag(d₀, d₁, d₂)` of SU(3) scales `e₁` by `d₀`. -/
theorem fund_diag_e1 (g : SU3) (d : Fin 3 → ℂ) (hg : g.1 = Matrix.diagonal d) :
    fund.ρ g e1 = d 0 • e1 := by
  change Matrix.toLin' g.1 (Pi.single 0 1 : Fin 3 → ℂ) = d 0 • (Pi.single 0 1 : Fin 3 → ℂ)
  rw [hg, Matrix.toLin'_apply]
  funext i
  fin_cases i <;> simp [Matrix.mulVec, dotProduct, Matrix.diagonal, Pi.single_apply]

/-- A diagonal element `diag(d₀, d₁, d₂)` of SU(3) scales `e₃*` by `conj d₂`. -/
theorem antifund_diag_e3dual (g : SU3) (d : Fin 3 → ℂ) (hg : g.1 = Matrix.diagonal d) :
    antifund.ρ g e3dual = (starRingEnd ℂ) (d 2) • e3dual := by
  change (show Module.Dual ℂ fund from fundᘁ.ρ g e3dual) =
    (starRingEnd ℂ) (d 2) • (show Module.Dual ℂ fund from e3dual)
  refine LinearMap.ext fun x => ?_
  refine (dual_ρ_apply fund g e3dual x).trans ?_
  change (Matrix.toLin' (star g.1) x) 2 = (starRingEnd ℂ) (d 2) * x 2
  rw [hg, Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose]
  change (Matrix.mulVec (Matrix.diagonal (star d)) (show Fin 3 → ℂ from x)) 2 = (starRingEnd ℂ) (d 2) * x 2
  rw [Matrix.mulVec_diagonal]
  rfl

/-- **`e₁^{⊗p} ⊗ e₃*^{⊗q}` is a torus weight vector of weight `(p, q)`.** The diagonal
element `diag(d₀, d₁, d₂)` acts on it by `d₀ ^ p * conj(d₂) ^ q`, the character with
Dynkin labels `(p, q)`. -/
theorem hwVec_torus_weight (g : SU3) (d : Fin 3 → ℂ) (hg : g.1 = Matrix.diagonal d)
    (p q : ℕ) :
    (tensorRep p q).ρ g (hwVec p q) = (d 0 ^ p * (starRingEnd ℂ) (d 2) ^ q) • hwVec p q :=
  rho_hwVec (fund_diag_e1 g d hg) (antifund_diag_e3dual g d hg) p q

/-! ### The representation `V(p, q)` generated by the highest-weight vector -/

/-- The SU(3)-span of `e₁^{⊗p} ⊗ e₃*^{⊗q}` inside `3^{⊗p} ⊗ 3̄^{⊗q}`. -/
noncomputable def irrepSub (p q : ℕ) : Submodule ℂ (tensorRep p q) :=
  Submodule.span ℂ (Set.range fun g : SU3 => (tensorRep p q).ρ g (hwVec p q))

theorem irrepSub_invariant (p q : ℕ) :
    ∀ g, ∀ w ∈ irrepSub p q, (tensorRep p q).ρ g w ∈ irrepSub p q := by
  intro g w hw
  have hle : irrepSub p q ≤ (irrepSub p q).comap ((tensorRep p q).ρ g) := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨h, rfl⟩
    change (tensorRep p q).ρ g ((tensorRep p q).ρ h (hwVec p q)) ∈ irrepSub p q
    rw [← Module.End.mul_apply, ← map_mul]
    exact Submodule.subset_span ⟨g * h, rfl⟩
  exact hle hw

/-- `V(p, q)`: the subrepresentation of `3^{⊗p} ⊗ 3̄^{⊗q}` generated by
`e₁^{⊗p} ⊗ e₃*^{⊗q}`, as an object of `FDRep ℂ SU3`. -/
noncomputable def irrepRep (p q : ℕ) : FDRep ℂ SU3 :=
  FDRep.of (Subrepresentation.toRepresentation
    (⟨irrepSub p q, fun g _ hw => irrepSub_invariant p q g _ hw⟩ :
      Subrepresentation (tensorRep p q).ρ))

/-- The inclusion `V(p, q) ⟶ 3^{⊗p} ⊗ 3̄^{⊗q}`. -/
noncomputable def irrepIncl (p q : ℕ) : irrepRep p q ⟶ tensorRep p q :=
  subIncl (tensorRep p q) (irrepSub p q) (irrepSub_invariant p q)

instance mono_irrepIncl (p q : ℕ) : Mono (irrepIncl p q) :=
  mono_subIncl (tensorRep p q) (irrepSub p q) (irrepSub_invariant p q)

theorem hwVec_mem (p q : ℕ) : hwVec p q ∈ irrepSub p q := by
  refine Submodule.subset_span ⟨1, ?_⟩
  change (tensorRep p q).ρ 1 (hwVec p q) = hwVec p q
  rw [map_one, Module.End.one_apply]

/-- The highest-weight vector as an element of `V(p, q)`. -/
noncomputable def hwIrrep (p q : ℕ) : irrepRep p q := ⟨hwVec p q, hwVec_mem p q⟩

theorem hwIrrep_ne_zero (p q : ℕ) : hwIrrep p q ≠ 0 := by
  intro h
  exact hwVec_ne_zero p q (congrArg Subtype.val h)

theorem irrepSub_ne_bot (p q : ℕ) : irrepSub p q ≠ ⊥ := by
  intro h
  have := hwVec_mem p q
  rw [h, Submodule.mem_bot] at this
  exact hwVec_ne_zero p q this

theorem irrepIncl_hw (p q : ℕ) : (irrepIncl p q).hom.hom.hom (hwIrrep p q) = hwVec p q := rfl

/-- `V(p, q)` is the smallest invariant subspace containing the highest-weight vector. -/
theorem irrepSub_le (p q : ℕ) (W : Submodule ℂ (tensorRep p q))
    (hW : ∀ g, ∀ w ∈ W, (tensorRep p q).ρ g w ∈ W) (hw : hwVec p q ∈ W) :
    irrepSub p q ≤ W := by
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨g, rfl⟩
  exact hW g _ hw

/-! ### Centre character and triality of `V(p, q)` -/

/-- **`V(p, q)` has centre character `ω ^ triality (p, q) = ω ^ ((p + 2q) mod 3)`.** -/
theorem centreCharacter_irrep (p q : ℕ) : CentreCharacter zω ω (irrepRep p q) (p, q) :=
  centreCharacter_of_mono (irrepIncl p q)

/-- On a nonzero representation the centre scalar is unique, so the triality label of a
representation that has a nonzero vector and centre character `ω ^ triality x` is determined. -/
theorem triality_eq_of_centreCharacter {X : FDRep ℂ SU3} {x y : Irrep} (v : X) (hv : v ≠ 0)
    (hx : CentreCharacter zω ω X x) (hy : CentreCharacter zω ω X y) :
    triality x = triality y := by
  have h1 := hx v
  rw [hy v] at h1
  have hs : ω ^ triality y = ω ^ triality x := smul_left_injective ℂ hv h1
  exact (omega_primitive.pow_inj (Nat.mod_lt _ (by norm_num)) (Nat.mod_lt _ (by norm_num)) hs).symm

/-- **The `(p, q)` label is forced.** If `V(p, q)` embeds in `3^{⊗p'} ⊗ 3̄^{⊗q'}`, then
`triality (p, q) = triality (p', q')`. -/
theorem triality_eq_of_mono {p q p' q' : ℕ} (f : irrepRep p q ⟶ tensorRep p' q') [Mono f] :
    triality (p, q) = triality (p', q') :=
  triality_eq_of_centreCharacter (hwIrrep p q) (hwIrrep_ne_zero p q) (centreCharacter_irrep p q)
    (centreCharacter_of_mono f)

/-- `V(1, 1)` (the adjoint, triality 0) does not have the centre character of `3 ⊗ 3`
(triality 2): `ω·I` does not act on it by `ω²`. -/
theorem irrep11_not_centre_omega_sq : ¬ CentreActs zω (ω ^ 2) (irrepRep 1 1) := by
  intro h
  have := triality_eq_of_centreCharacter (y := (2, 0)) (hwIrrep 1 1) (hwIrrep_ne_zero 1 1)
    (centreCharacter_irrep 1 1) (by unfold CentreCharacter; simpa [triality] using h)
  simp [triality] at this

/-- `V(1, 1)` does not embed in `3 ⊗ 3`. -/
theorem irrep11_not_mono_tensor20 : ¬ ∃ f : irrepRep 1 1 ⟶ tensorRep 2 0, Mono f := by
  rintro ⟨f, hf⟩
  have := triality_eq_of_mono f
  simp [triality] at this

/-! ### n-valent triality for arms labelled by `V(p, q)` -/

/-- **n-valent triality conservation for arms carrying `V(p, q)`.** If every arm's
representation is isomorphic to `V(p, q)` for its label `(p, q)`, a nonzero vertex invariant
forces the signed trialities to sum to `0` mod 3. -/
theorem nvalent_triality_irrep (arms : List (HalfEdge ℂ SU3 × Irrep))
    (hiso : ∀ a ∈ arms, Nonempty (a.1.rep ≅ irrepRep a.2.1 a.2.2))
    (hinv : Representation.invariants (vertexRep (arms.map Prod.fst)).ρ ≠ ⊥) :
    vertexTri (arms.map (fun a => (a.1.out, a.2))) = 0 := by
  refine nvalent_triality_SU3 arms (fun a ha => ?_) hinv
  obtain ⟨i⟩ := hiso a ha
  exact ⟨i.hom ≫ irrepIncl a.2.1 a.2.2, inferInstance⟩

/-- The same for arms that are literally `V(p, q)`. -/
theorem nvalent_triality_irrepRep (arms : List (HalfEdge ℂ SU3 × Irrep))
    (hrep : ∀ a ∈ arms, a.1.rep = irrepRep a.2.1 a.2.2)
    (hinv : Representation.invariants (vertexRep (arms.map Prod.fst)).ρ ≠ ⊥) :
    vertexTri (arms.map (fun a => (a.1.out, a.2))) = 0 :=
  nvalent_triality_irrep arms (fun a ha => ⟨eqToIso (hrep a ha)⟩) hinv

end IrrepEmbedSU3
