import SupportDichotomy
import IrrepSmallIsoSU3

/-!
# Dynkin labels on links: non-trivial exactly when the label is not `(0, 0)`

Author: Jeromie Beasley (Lean Green PR Machine, Grok Bot), with the Team.
ORCID https://orcid.org/0009-0006-4645-5643 · GitHub dicipler-pixel · X @d1c1pler ·
YouTube @AtlasMemoriae · atlas-memoriae.dicipler.workers.dev

Index the link irreps by Dynkin label: `Irr = ℕ × ℕ` and `irrPQ (p, q) = irrepRep p q`, the
representation `V(p, q) ⊆ 3^{⊗p} ⊗ 3̄^{⊗q}` generated by the highest-weight vector
`e₁^{⊗p} ⊗ e₃*^{⊗q}` (#30, `IrrepEmbedSU3`).

* `(0, 0)` is trivial, via Spectrum's `irrep00Iso : irrepRep 0 0 ≅ 𝟙` (#38).
* Any other label is non-trivial. This uses a torus element. If `𝟙 ≅ V(p, q)`, every
  `g ∈ SU(3)` acts on `V(p, q)` as the identity. But `diag(t, t̄, 1)` (for `p ≥ 1`) or
  `diag(1, t, t̄)` (for `p = 0, q ≥ 1`), with `t` a primitive `(n+1)`-th root of unity, scales the
  highest-weight vector by `t ^ p` resp. `t ^ q ≠ 1` (`hwVec_torus_weight`). The highest-weight
  vector is nonzero, which gives the contradiction.

So `NTe (irrPQ ∘ π) e ↔ π e ≠ (0, 0)` (`NTe_irrPQ_iff`). The labelling hypothesis `hnt` of
`SupportDichotomy.long_energy_floor` is therefore a theorem, and `long_energy_floor_irrep`
needs no hypothesis at all: not even `PeterWeylLattice`.

`NormInj` is not used. It constrains link endpoints (no two links with the same normalised
vertex pair), not labels, so it has no bearing on which labels are trivial.

The dichotomy with the energy floor (`list_support_dichotomy_energy`) still needs the irreps to
be simple, because `PeterWeylLattice`'s support rule does. Irreducibility of `V(p, q)` is not
formalized in the repo (#30 leaves it open), so `[∀ x, Simple (irrPQ x)]` is a named
hypothesis there, not proved.
-/

open CategoryTheory MonoidalCategory TailFloor GaugeSupport SmallSupportBridge NtListSupport PermCube
  GraphInstances SupportDichotomy TrialityVertex CentreCharacterSU3 IrrepEmbedSU3
  IrrepSmallIsoSU3
open scoped Classical

namespace HntLabels

/-- Link irreps indexed by Dynkin label: `irrPQ (p, q) = V(p, q)`. -/
noncomputable def irrPQ (x : ℕ × ℕ) : FDRep ℂ CentreCharacterSU3.SU3 := irrepRep x.1 x.2

/-- A diagonal unitary matrix with determinant one lies in SU(3). -/
theorem diag_mem (d : Fin 3 → ℂ) (hu : ∀ i, star (d i) * d i = 1)
    (hdet : d 0 * d 1 * d 2 = 1) : Matrix.diagonal d ∈ CentreCharacterSU3.SU3 := by
  rw [Matrix.mem_specialUnitaryGroup_iff]
  refine ⟨?_, ?_⟩
  · rw [Matrix.mem_unitaryGroup_iff', Matrix.star_eq_conjTranspose,
      Matrix.diagonal_conjTranspose, Matrix.diagonal_mul_diagonal]
    have : (fun i => (star d) i * d i) = fun _ => (1 : ℂ) := funext hu
    rw [this, Matrix.diagonal_one]
  · rw [Matrix.det_diagonal, Fin.prod_univ_three, hdet]

/-- If some group element scales the highest-weight vector by `c ≠ 1`, then `V(p, q)` is not
trivial. -/
theorem not_trivial_of_weight {p q : ℕ} (g : CentreCharacterSU3.SU3) (c : ℂ) (hc1 : c ≠ 1)
    (hc : (tensorRep p q).ρ g (hwVec p q) = c • hwVec p q) :
    IsEmpty (𝟙_ (FDRep ℂ CentreCharacterSU3.SU3) ≅ irrepRep p q) := by
  refine ⟨fun i => ?_⟩
  have h1 : CentreActs g (1 : ℂ) (irrepRep p q) :=
    centreActs_of_mono i.inv (centreActs_unit (k := ℂ) g)
  have h2 := h1 (hwIrrep p q)
  have h := congrArg (fun m => m.hom.hom (hwIrrep p q)) ((irrepIncl p q).comm g)
  change (irrepIncl p q).hom.hom.hom ((irrepRep p q).ρ g (hwIrrep p q)) =
    (tensorRep p q).ρ g ((irrepIncl p q).hom.hom.hom (hwIrrep p q)) at h
  rw [h2, one_smul, irrepIncl_hw, hc] at h
  have h0 : (c - 1) • hwVec p q = 0 := by rw [sub_smul, one_smul, ← h, sub_self]
  rcases smul_eq_zero.1 h0 with h0 | h0
  · exact hc1 (sub_eq_zero.1 h0)
  · exact hwVec_ne_zero p q h0

/-- A primitive `(n+1)`-th root of unity: unit modulus and `t ^ n ≠ 1` for `n ≥ 1`. -/
theorem root_facts (n : ℕ) (hn : 1 ≤ n) :
    ∃ t : ℂ, star t * t = 1 ∧ t ^ n ≠ 1 := by
  have hprim := Complex.isPrimitiveRoot_exp (n + 1) (by omega)
  refine ⟨Complex.exp (2 * Real.pi * Complex.I / (n + 1 : ℕ)), ?_, ?_⟩
  · have hnorm := hprim.norm'_eq_one (by omega)
    rw [mul_comm, Complex.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, hnorm]
    norm_num
  · intro h
    have := (hprim.pow_eq_one_iff_dvd n).1 h
    have := Nat.le_of_dvd (by omega) this
    omega

/-- **Every label other than `(0, 0)` is non-trivial.** -/
theorem irrep_nontrivial {p q : ℕ} (h : (p, q) ≠ (0, 0)) :
    IsEmpty (𝟙_ (FDRep ℂ CentreCharacterSU3.SU3) ≅ irrepRep p q) := by
  rcases Nat.eq_zero_or_pos p with hp | hp
  · subst hp
    have hq : 1 ≤ q := by
      rcases Nat.eq_zero_or_pos q with hq | hq
      · exact absurd (by rw [hq]) h
      · exact hq
    obtain ⟨t, ht, htq⟩ := root_facts q hq
    let d : Fin 3 → ℂ := ![1, t, star t]
    have hu : ∀ i, star (d i) * d i = 1 := by
      intro i; fin_cases i
      · simp [d]
      · exact ht
      · simp only [d]; change star (star t) * star t = 1
        rw [star_star, mul_comm, ht]
    have hdet : d 0 * d 1 * d 2 = 1 := by
      simp only [d]; change 1 * t * star t = 1
      rw [one_mul, mul_comm, ht]
    refine not_trivial_of_weight ⟨Matrix.diagonal d, diag_mem d hu hdet⟩ (t ^ q) htq ?_
    rw [hwVec_torus_weight _ d rfl 0 q]
    congr 1
    simp only [d]
    change (1 : ℂ) ^ 0 * (starRingEnd ℂ) (star t) ^ q = t ^ q
    rw [one_pow, one_mul, ← Complex.star_def, star_star]
  · obtain ⟨t, ht, htp⟩ := root_facts p hp
    let d : Fin 3 → ℂ := ![t, star t, 1]
    have hu : ∀ i, star (d i) * d i = 1 := by
      intro i; fin_cases i
      · exact ht
      · simp only [d]; change star (star t) * star t = 1
        rw [star_star, mul_comm, ht]
      · simp [d]
    have hdet : d 0 * d 1 * d 2 = 1 := by
      simp only [d]; change t * star t * 1 = 1
      rw [mul_one, mul_comm, ht]
    refine not_trivial_of_weight ⟨Matrix.diagonal d, diag_mem d hu hdet⟩ (t ^ p) htp ?_
    rw [hwVec_torus_weight _ d rfl p q]
    congr 1
    simp only [d]
    change t ^ p * (starRingEnd ℂ) 1 ^ q = t ^ p
    rw [map_one, one_pow, mul_one]

/-- **`V(p, q)` is trivial exactly at `(0, 0)`.** -/
theorem irrep_trivial_iff (p q : ℕ) :
    Nonempty (𝟙_ (FDRep ℂ CentreCharacterSU3.SU3) ≅ irrepRep p q) ↔ (p, q) = (0, 0) := by
  constructor
  · intro ⟨i⟩
    by_contra h
    exact (irrep_nontrivial h).false i
  · intro h
    simp only [Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨irrep00Iso.symm⟩

/-- **A link is non-trivial exactly when its label is not `(0, 0)`.** -/
theorem NTe_irrPQ_iff {E : Type*} (π : E → ℕ × ℕ) (e : E) :
    NTe (irrPQ ∘ π) e ↔ π e ≠ (0, 0) := by
  unfold NTe
  rw [← not_nonempty_iff]
  change ¬ Nonempty (𝟙_ (FDRep ℂ CentreCharacterSU3.SU3) ≅ irrepRep (π e).1 (π e).2) ↔ _
  rw [irrep_trivial_iff]

/-- **`hnt` derived.** A non-trivial link has `p + q ≥ 1`. -/
theorem hnt_irrPQ {E : Type*} (π : E → ℕ × ℕ) :
    ∀ e, NTe (irrPQ ∘ π) e → (id (π e)).1 + (id (π e)).2 ≥ 1 := by
  intro e he
  have h := (NTe_irrPQ_iff π e).1 he
  simp only [id]
  by_contra hc
  exact h (Prod.ext (by omega) (by omega))

/-- **`long_energy_floor` without `hnt`.** With links labelled by `(p, q)` and `irr = V(p, q)`,
more than six non-trivial links cost at least `28` in `c3 = 3·C₂` units. No hypothesis. -/
theorem long_energy_floor_irrep {E : Type*} [Fintype E] (π : E → ℕ × ℕ)
    (hlong : 6 < (Finset.univ.filter (NTe (irrPQ ∘ π))).card) :
    (((Finset.univ.filter (NTe (irrPQ ∘ π))).toList).map
      (fun e => c3 (π e).1 (π e).2)).sum ≥ 28 :=
  long_energy_floor irrPQ π id (hnt_irrPQ π) hlong

/-- **Dichotomy with the energy floor on `listΓ g n`, links labelled by `(p, q)`.** Either 4 or
6 non-trivial links forming a short cycle, or more than 6 with `Σ c3 ≥ 28`. Hypotheses:
`PeterWeylLattice` and the named hypothesis `[∀ x, Simple (irrPQ x)]` (irreducibility of
`V(p, q)`, not formalized in the repo). -/
theorem list_support_dichotomy_energy (g : Graph) (n : ℕ) (hmem : LinksIn g n)
    (hinj : NormInj g n) (hs : simpleB g = true) (hSSAC : SmallSupportsAreCycles g)
    [∀ x, Simple (irrPQ x)] {H : Type*} [AddCommGroup H] [Module ℂ H]
    {gauge : Representation ℂ (Fin (n + 1) → CentreCharacterSU3.SU3) H}
    (PW : PeterWeylLattice ℂ CentreCharacterSU3.SU3 (listΓ g n) (ℕ × ℕ) irrPQ H gauge)
    (ψ : H) (hψ : ∀ g, gauge g ψ = ψ) (π : Fin g.length → ℕ × ℕ) (hπ : PW.proj π ψ ≠ 0)
    (h1 : 1 ≤ (Finset.univ.filter (NTe (irrPQ ∘ π))).card) :
    (((Finset.univ.filter (NTe (irrPQ ∘ π))).card = 4 ∨
        (Finset.univ.filter (NTe (irrPQ ∘ π))).card = 6) ∧
      shortCycle (supportList (listΓ g n) (irrPQ ∘ π) Fin.val) = true) ∨
    (6 < (Finset.univ.filter (NTe (irrPQ ∘ π))).card ∧
      (((Finset.univ.filter (NTe (irrPQ ∘ π))).toList).map
        (fun e => c3 (π e).1 (π e).2)).sum ≥ 28) := by
  rcases list_support_dichotomy g n hmem hinj hs hSSAC PW ψ hψ π hπ h1 with h | h
  · exact Or.inl h
  · exact Or.inr ⟨h.1, long_energy_floor_irrep π h.1⟩

end HntLabels
