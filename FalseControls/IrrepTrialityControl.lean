   centre character of `3 ⊗ 3`, i.e. triality `(2 + 0) % 3 = 2`, as it would if it embedded in
   `3 ⊗ 3`. Its true triality is `(1 + 2) % 3 = 0` (`centreCharacter_irrep 1 1`), and
   `irrep11_not_centre_omega_sq` proves the claim false. Must fail to compile. -/
namespace IrrepEmbedSU3

open ThetaTriality TrialityVertex CentreCharacterSU3

theorem irrep11_has_triality_of_33 : CentreCharacter zω ω (irrepRep 1 1) (2, 0) := by
  have h := centreCharacter_irrep 1 1
  unfold CentreCharacter at h ⊢
  simpa [triality] using h

end IrrepEmbedSU3
